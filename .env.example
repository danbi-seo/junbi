# JUNBI 환경변수 — 값은 비워 둔다. 실제 값은 .env.local(로컬)과 Vercel(배포)에.
#
# NEXT_PUBLIC_ 접두어 = 브라우저 번들에 들어가도 되는 값.
# 접두어가 없는 것은 서버 전용이며, 절대 NEXT_PUBLIC_을 붙이지 않는다.
# 서버 전용 키는 Vercel에서 Production 스코프에만 체크한다.

# ── 클라이언트 노출 OK ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=            # 지도 SDK. 카카오 콘솔에서 도메인 제한 필수
NEXT_PUBLIC_VAPID_PUBLIC_KEY=        # 한 번 정하면 바꾸지 않는다. 바꾸면 푸시 구독 전부 무효

# ── 서버 전용 ────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=           # 모든 RLS를 무시하는 마스터 키
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                       # mailto:you@example.com
CRON_SECRET=                         # /api/push/send 보호. 없으면 누구나 알림 발송 가능
ENCRYPTION_KEY=                      # 구글 refresh token 암호화

KAKAO_REST_KEY=                      # 장소 검색(로컬 API)
KAKAO_CLIENT_ID=                     # 로그인. Supabase Auth에 등록
KAKAO_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub Actions 시크릿 (레포에 넣지 않음. Actions 설정에만) ──
# SUPABASE_DB_URL      백업 덤프용. DB 비밀번호 포함
# BACKUP_REPO_TOKEN    fine-grained PAT. junbi-backup 레포에만 Contents:RW

# ── 개발용 계정 (검증 스크립트. 로컬에서만 채운다) ──
DEV_EMAIL_A=
DEV_EMAIL_B=
DEV_PASSWORD=
